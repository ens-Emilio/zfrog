# zfrog - Output directory
/output/

# Runtime state. Every pattern is anchored to the repo root: an unanchored
# `workflows/` or `analysis/` also matches `.github/workflows/` and
# `src/zfrog/analysis/`, which would silently keep source out of the repo.
# sessions/ holds cookie values — never commit it.
/versions/
/sessions/
/search.db
/schedules.json
/workflows/
/metrics.db
# SQLite leaves these two beside an open database. Without the wildcard they are
# not covered by the rule above and get committed on the next `git add -A`.
/metrics.db-*
/search.db-*
/catalog.db
/catalog.db-*
/audit.log
/api_keys.json
/marketplace/
/integrations/
/templates/
/users.json
/orgs.json
/annotations/
/workers.json
/websession.key
*.key
/analysis/
/finetune/
/totp.json
/arweave-wallet.json
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Rust / Tauri (gerado)
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/zfrog-api-*
!src-tauri/binaries/.gitkeep

# Virtual environment
venv/
.venv/

# Cache / lint (têm .gitignore interno, mas o root garante se ele for apagado)
.ruff_cache/

# Environment files
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

