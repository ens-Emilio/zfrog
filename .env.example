# Zfrog Configuration
# Copy this file to .env and modify as needed

# Redis (required for Celery workers)
ZFROG_REDIS_URL=redis://localhost:6379/0

# Output directory
ZFROG_OUTPUT_DIR=output

# Concurrency limits
ZFROG_MAX_CONCURRENT_JOBS=5
ZFROG_WORKER_CONCURRENCY=2

# Proxy (optional)
# ZFROG_PROXY_URL=http://user:pass@proxy:8080

# HTTP timeouts (seconds)
ZFROG_HTTP_TIMEOUT_CONNECT=30
ZFROG_HTTP_TIMEOUT_READ=60

# Engine plugins (directory of *.py files; ignored when absent)
ZFROG_PLUGINS_DIR=plugins

# Change detection: share of changed pages that triggers the site.changed webhook
ZFROG_CHANGE_ALERT_THRESHOLD=0.1

# Versioning / delta / scheduling / search
ZFROG_VERSIONS_DIR=versions
ZFROG_DELTA_MAX_PAGES=200
ZFROG_SCHEDULES_FILE=schedules.json
ZFROG_SCHEDULER_INTERVAL_S=30
ZFROG_SEARCH_DB=search.db

# Login sessions (cookie values live here; files are chmod 0600, never commit them)
ZFROG_SESSIONS_DIR=sessions

# Kubernetes operator
ZFROG_K8S_NAMESPACE=default
ZFROG_K8S_WORKER_IMAGE=zfrog-worker:latest
# ZFROG_K8S_API_SERVER=https://kubernetes.default.svc

# Session encryption key (created 0600 on first use when cryptography is installed)
# ZFROG_SESSIONS_KEY_FILE=sessions/.key

# IPFS publishing (needs a local Kubo node)
ZFROG_IPFS_ENABLED=false
ZFROG_IPFS_API_URL=http://127.0.0.1:5001

# Content safety scan for cloned pages
ZFROG_SAFETY_ENABLED=true

# Audit trail and per-engine metrics
ZFROG_AUDIT_LOG=audit.log
ZFROG_METRICS_DB=metrics.db

# Workflow DAG execution
ZFROG_MAX_PARALLEL_STEPS=4

# Content-aware change alerts and translation
ZFROG_SIGNIFICANCE_THRESHOLD=0.35
ZFROG_TRANSLATION_TARGET=pt

# Cost model (0 = report resources only, no money)
ZFROG_COST_PER_GB_TRANSFER=0.0
ZFROG_COST_PER_CPU_HOUR=0.0
ZFROG_COST_PER_GB_MONTH=0.0
ZFROG_COST_CURRENCY=BRL

# API authentication (off by default: every endpoint stays open)
ZFROG_AUTH_ENABLED=false
ZFROG_API_KEYS_FILE=api_keys.json

# Region-aware dispatch (edge deployment)
ZFROG_REGION=local
# ZFROG_WORKER_REGIONS=sa-east:20:4,us-east:180:2

# Marketplace and outbound integrations
ZFROG_MARKETPLACE_DIR=marketplace
ZFROG_INTEGRATIONS_DIR=integrations

# HTTP / probe tuning
ZFROG_HTTP_MAX_REDIRECTS=10
ZFROG_PROBE_TIMEOUT=15
ZFROG_SPA_CONTENT_THRESHOLD=2048
ZFROG_WGET_TIMEOUT=300

# Browser pool (Playwright)
ZFROG_BROWSER_POOL_SIZE=3
ZFROG_BROWSER_CONTEXT_MAX_PAGES=50
ZFROG_BROWSER_CONTEXT_MAX_AGE_S=1800

# Video download limits
ZFROG_VIDEO_MAX_BYTES=500000000
ZFROG_VIDEO_MAX_SEGMENTS=5000

# IPFS request timeout
ZFROG_IPFS_TIMEOUT_S=60

# Identity: users and organizations (both files are 0600)
ZFROG_USERS_FILE=users.json
ZFROG_ORGS_FILE=orgs.json
ZFROG_DEFAULT_ORG=default

# SSO (OpenID Connect). Empty issuer/client id = SSO disabled.
ZFROG_OIDC_ISSUER=
ZFROG_OIDC_CLIENT_ID=
ZFROG_OIDC_CLIENT_SECRET=
ZFROG_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
ZFROG_OIDC_SCOPES=openid email profile
ZFROG_OIDC_USERNAME_CLAIM=email
ZFROG_OIDC_GROUPS_CLAIM=groups
# ZFROG_OIDC_GROUP_ROLE_MAP=admins=admin,devs=operator

# Annotations and domain profiles
ZFROG_ANNOTATIONS_DIR=annotations
ZFROG_DOMAIN_PROFILES_DIR=domains

# Design reference catalog: cards (screenshot + tokens + tags) and where the
# screenshots are served from. `catalog_media_dir` must be the directory the
# captures are written under, or /catalog/{id}/screenshot will 404.
ZFROG_CATALOG_DB=catalog.db
ZFROG_CATALOG_MEDIA_DIR=output

# Search backend: sqlite (built in), meilisearch or elasticsearch
ZFROG_SEARCH_BACKEND=sqlite
ZFROG_MEILISEARCH_URL=http://127.0.0.1:7700
# ZFROG_MEILISEARCH_KEY=
ZFROG_ELASTICSEARCH_URL=http://127.0.0.1:9200
ZFROG_ELASTICSEARCH_INDEX=zfrog
# ZFROG_ELASTICSEARCH_USER=
# ZFROG_ELASTICSEARCH_PASSWORD=

# Workers
ZFROG_WORKERS_HEARTBEAT_TTL_S=60
# ZFROG_WORKER_ID=
ZFROG_WORKER_API_PORT=8000
ZFROG_WORKER_API_SCHEME=http
ZFROG_DISPATCH_TIMEOUT_S=30

# Price monitoring
ZFROG_PRICE_ALERT_DROP_PCT=5.0
ZFROG_PRICE_ALERT_RISE_PCT=5.0
ZFROG_PRICE_CURRENCY_HINT=BRL

# Two-factor codes (RFC 6238) for your own accounts
ZFROG_TOTP_DIGITS=6
ZFROG_TOTP_PERIOD_S=30

# Fine-tuning datasets (training itself runs elsewhere)
ZFROG_FINETUNE_DIR=finetune

# Competitive / trend analysis
ZFROG_ANALYSIS_DIR=analysis

# Marketplace server
ZFROG_MARKETPLACE_HOST=127.0.0.1
ZFROG_MARKETPLACE_PORT=8200

# Arweave permanent archiving (needs a funded wallet)
ZFROG_ARWEAVE_ENABLED=false
ZFROG_ARWEAVE_GATEWAY=https://arweave.net
ZFROG_ARWEAVE_WALLET_FILE=arweave-wallet.json
ZFROG_ARWEAVE_TIMEOUT_S=120

# ROI assumptions (not measurements — they drive the estimate)
ZFROG_ROI_HOURLY_RATE=0.0
ZFROG_ROI_MANUAL_MINUTES_PER_PAGE=2.0

# ── Deployment ──────────────────────────────────────────────────────────────

# Root for every state file (keys, users, sessions, versions, indexes). Point it
# at a mounted volume in a container, or a restart loses all of it.
ZFROG_DATA_DIR=.

# Origins allowed to call the API from a browser. "*" suits local use; list the
# real ones when the API is public.
ZFROG_CORS_ORIGINS=*

# Allow fetching private/loopback addresses. True is right locally (you clone your
# own machine and LAN). Set false before exposing the API: otherwise a request can
# make the server read cloud metadata (169.254.169.254) or scan the internal
# network.
ZFROG_ALLOW_PRIVATE_HOSTS=true

# Authentication is OFF by default so local use needs no setup. Turn it on before
# exposing the API — with it off, anyone who reaches the port can create jobs,
# publish to Arweave and read every clone.
ZFROG_AUTH_ENABLED=false

# Signing key for the dashboard's session cookie, created mode 0600 on the first
# SSO login. Losing it logs everyone out; it is not a data-loss event.
ZFROG_WEBSESSION_KEY_FILE=websession.key
# How long a dashboard session lasts, in seconds (default 8 hours).
ZFROG_WEBSESSION_TTL_S=28800
# Force the Secure flag on the session cookie. Set true when TLS terminates at a
# proxy that does not forward the original scheme.
ZFROG_SESSION_COOKIE_SECURE=false
# Where the browser lands after a successful SSO login.
ZFROG_POST_LOGIN_REDIRECT=http://localhost:3000
