{
  "productName": "zfrog",
  "version": "0.1.3",
  "identifier": "com.zfrog.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix dashboard run dev -- --port 3000 --host 127.0.0.1",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "zfrog",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://asset.localhost; script-src 'self' 'sha256-36VkN0JwhRbigrUJFbD23oBUac8yFW2quF+XDCPNq9A=' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: http: https:; connect-src 'self' https://github.com https://api.github.com https://objects.githubusercontent.com https://*.githubusercontent.com https://*.githubassets.com http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Zfrog Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Design reference engine",
    "longDescription": "Capture, organize and adapt web design references.",
    "externalBin": [
      "binaries/zfrog-api"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0OTBBMDc4NjI2NDQ1RjEKUldUeFJXUmllS0NRTk5sTEdrL3o2aUpKWW1IU1ZFVEtUZDBESnAyZ2VjdzdJcUdYQXY0bnlZNVYK",
      "endpoints": [
        "https://github.com/ens-Emilio/zfrog/releases/latest/download/latest.json"
      ]
    }
  }
}
