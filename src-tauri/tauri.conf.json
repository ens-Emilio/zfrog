{
  "productName": "zfrog",
  "version": "0.1.0",
  "identifier": "com.zfrog.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 3000 --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "zfrog",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Zfrog Contributors",
    "category": "DeveloperTool",
    "shortDescription": "Design reference engine",
    "longDescription": "Capture, organize and adapt web design references.",
    "externalBin": [
      "binaries/zfrog-api"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
